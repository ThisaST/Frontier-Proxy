---
// System / Light / Dark segmented control — the site's equivalent of Settings →
// Appearance → Scheme in the app (src/renderer/index.html's #appearance-scheme,
// src/renderer/src/theme.ts). Same localStorage key (`fp-scheme`), same
// radiogroup pattern (roving tabindex + arrow keys, ui/segmented.ts), same
// before-paint resolution (public/theme-init.js). The site has one theme
// family, so this only chooses the scheme.
---

<div class="theme-toggle segmented" id="site-theme-toggle" role="radiogroup" aria-label="Colour scheme">
  <button type="button" data-scheme-choice="system" role="radio" aria-checked="false">System</button>
  <button type="button" data-scheme-choice="light" role="radio" aria-checked="false">Light</button>
  <button type="button" data-scheme-choice="dark" role="radio" aria-checked="false">Dark</button>
</div>

<script>
  const SCHEME_KEY = "fp-scheme";

  function readScheme(): string {
    try {
      const stored = localStorage.getItem(SCHEME_KEY);
      return stored === "light" || stored === "dark" ? stored : "system";
    } catch {
      return "system";
    }
  }

  function writeScheme(value: string): void {
    try {
      localStorage.setItem(SCHEME_KEY, value);
    } catch {
      /* private mode / disabled storage */
    }
  }

  function prefersDark(): boolean {
    return typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function applyScheme(): void {
    const scheme = readScheme();
    const resolved = scheme === "system" ? (prefersDark() ? "dark" : "light") : scheme;
    document.documentElement.setAttribute("data-scheme", resolved);
    syncGroup(scheme);
  }

  const group = document.getElementById("site-theme-toggle");
  const options = () => [...(group?.querySelectorAll<HTMLButtonElement>('[role="radio"]') ?? [])];

  function syncGroup(scheme: string): void {
    for (const el of options()) {
      const checked = el.dataset.schemeChoice === scheme;
      el.setAttribute("aria-checked", String(checked));
      el.tabIndex = checked ? 0 : -1;
    }
  }

  function select(el: HTMLButtonElement): void {
    writeScheme(el.dataset.schemeChoice ?? "system");
    applyScheme();
  }

  if (group) {
    for (const el of options()) {
      el.addEventListener("click", () => select(el));
    }
    // Roving tabindex + arrow-key navigation — same pattern as the app's
    // ui/segmented.ts initRadioGroup, reimplemented here since the site has
    // no shared module to import from.
    group.addEventListener("keydown", (event) => {
      const list = options();
      const current = list.indexOf(document.activeElement as HTMLButtonElement);
      if (current < 0) return;
      const move = (delta: number): void => {
        const next = list[(current + delta + list.length) % list.length];
        next.focus();
        select(next);
      };
      if (event.key === "ArrowRight" || event.key === "ArrowDown") { event.preventDefault(); move(1); }
      else if (event.key === "ArrowLeft" || event.key === "ArrowUp") { event.preventDefault(); move(-1); }
      else if (event.key === "Home") { event.preventDefault(); list[0].focus(); select(list[0]); }
      else if (event.key === "End") { event.preventDefault(); list[list.length - 1].focus(); select(list[list.length - 1]); }
    });
  }

  applyScheme();

  if (typeof window.matchMedia === "function") {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (readScheme() === "system") applyScheme(); });
  }
</script>

<style>
  /* Compact enough to sit on one line next to the rest of the nav at 1280,
     and to fit the mobile disclosure menu at 390 — the app's own segmented
     control (Settings → Appearance) has more room to breathe than a top nav. */
  .theme-toggle { flex: 0 0 auto; }
  .theme-toggle button {
    padding: 5px 9px;
    font-size: 12px;
  }
</style>
