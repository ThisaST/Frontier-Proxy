{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "src/renderer/src/theme-model.ts", "src/renderer/src/nav.ts", "src/renderer/src/advisor-disclosure.ts", "tests/**/*.ts"],
  "exclude": ["tests/components.test.ts", "tests/dirty.test.ts"]
}
