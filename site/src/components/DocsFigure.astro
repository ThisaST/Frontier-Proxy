---
// A framed figure wrapping a scheme-aware app Screenshot, for embedding
// real UI inside docs prose.
import Screenshot from "./Screenshot.astro";
import type { ScreenName } from "../lib/screens";

interface Props { name: ScreenName; alt: string; caption: string }
const { name, alt, caption } = Astro.props;
---

<figure class="docs-figure panel">
  <Screenshot name={name} alt={alt} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .docs-figure { margin: 0 0 26px; overflow: hidden; }
  .docs-figure :global(.theme-shot) { display: block; }
  .docs-figure figcaption { padding: 12px 16px; border-top: 1px solid var(--border); color: var(--fg-muted); font-size: 12.5px; }
</style>
