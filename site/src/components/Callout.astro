---
interface Props { title?: string; tone?: "green" | "warn" | "info" }
const { title, tone = "green" } = Astro.props;
---

<aside class={`callout ${tone === "green" ? "" : tone}`}>
  <span class="pulse-dot"></span>
  <div>
    {title && <strong class="callout-title">{title}</strong>}
    <slot />
  </div>
</aside>
