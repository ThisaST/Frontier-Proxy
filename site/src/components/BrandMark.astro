---
// The site's brand mark: a small scope in the Neutral accent — two rings, a
// crosshair and a sweep — so it reads as the same product as the app icon
// without carrying the Phosphor palette. Flat and static.
interface Props { size?: number }
const { size = 29 } = Astro.props;
---

<span class="brand-mark" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none">
    <circle cx="16" cy="16" r="14.5" stroke="var(--border-strong)" stroke-width="1" />
    <circle cx="16" cy="16" r="10" stroke="var(--accent)" stroke-width="1" opacity="0.45" />
    <circle cx="16" cy="16" r="5.5" stroke="var(--accent)" stroke-width="1" opacity="0.65" />
    <path d="M16 1.5V4M16 28v2.5M1.5 16H4M28 16h2.5" stroke="var(--border-strong)" stroke-width="1" />
    <path d="M16 16 L16 3.5 A12.5 12.5 0 0 1 27 10.5 Z" fill="var(--accent)" opacity="0.22" />
    <circle cx="16" cy="16" r="2" fill="var(--accent)" />
  </svg>
</span>
