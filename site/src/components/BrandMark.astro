---
// Radar scope brand mark — replaces the old green petal ellipses. Amber
// rings and crosshair with a sweep blip, matching the app's radar-sweep
// motif (docs/design-phosphor-console.md §4.5). Static here (no rotation);
// the animated version lives in the .radar.sweep CSS class used elsewhere
// on the site for "advising" states.
interface Props { size?: number }
const { size = 29 } = Astro.props;
---

<span class="brand-mark" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none">
    <circle cx="16" cy="16" r="14.5" stroke="var(--bezel-strong)" stroke-width="1" />
    <circle cx="16" cy="16" r="10" stroke="var(--amber)" stroke-width="1" opacity="0.45" />
    <circle cx="16" cy="16" r="5.5" stroke="var(--amber)" stroke-width="1" opacity="0.65" />
    <path d="M16 1.5V4M16 28v2.5M1.5 16H4M28 16h2.5" stroke="var(--bezel-strong)" stroke-width="1" />
    <path d="M16 16 L16 3.5 A12.5 12.5 0 0 1 27 10.5 Z" fill="var(--amber)" opacity="0.22" />
    <circle cx="16" cy="16" r="2" fill="var(--amber)" />
  </svg>
</span>
