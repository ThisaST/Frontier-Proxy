{
  "name": "frontier-proxy",
  "version": "0.6.0",
  "private": true,
  "description": "A local-first desktop router for Codex, Claude Code, and open-source coding agents.",
  "author": {
    "name": "Frontier Proxy contributors",
    "email": "thisapramuditha@gmail.com"
  },
  "desktopName": "frontier-proxy.desktop",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "dev.frontierproxy.app",
    "productName": "Frontier Proxy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
