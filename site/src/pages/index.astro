---
import Base from "../layouts/Base.astro";
import DownloadTable from "../components/DownloadTable.astro";
import Callout from "../components/Callout.astro";
import Screenshot from "../components/Screenshot.astro";
import { url, REPO_URL } from "../lib/site";
import { version } from "../lib/release";

const tour = [
  {
    id: "home",
    label: "Home",
    screen: "home" as const,
    alt: "The Home screen's composer with a live route preview showing the chosen agent, model, and tier before the task is sent",
    heading: "Composer-first",
    bullets: [
      "Describe a task and watch a live route preview — agent · model · tier — before anything runs.",
      "A small radar sweep plays while the route is being scored.",
      "The project switcher scopes Home, Tasks, Review, and Workspaces to one repository at a time.",
    ],
  },
  {
    id: "tasks",
    label: "Tasks",
    screen: "tasks" as const,
    alt: "The Tasks screen split into three panes: the work queue, a streaming conversation, and the route inspector",
    heading: "Three panes, not a modal",
    bullets: [
      "Work queue, conversation, and a collapsible route/files/activity inspector — one screen, nothing to double-click open.",
      "The route inspector shows Jev's reasoning: task-type probabilities, complexity mapped to a tier, and the best-fit call.",
      "Changed files open in an overlay with syntax highlighting and a real Git diff.",
    ],
  },
  {
    id: "routing",
    label: "Routing",
    screen: "routing" as const,
    alt: "The Routing screen showing the Jev advisor's Off, Shadow, and Active modes, a write-only credential field, and the request payload preview",
    heading: "An optional second opinion",
    bullets: [
      "Off, Shadow, or Active — off by default, and Shadow changes nothing about what runs.",
      "A write-only key field plus Test connection; the exact request payload is previewable before you ever send one.",
      "The model catalog and a calibration view of how confidence tracked real outcomes.",
    ],
  },
  {
    id: "agents",
    label: "Agents",
    screen: "agent-drawer" as const,
    alt: "The Agents table with login state and plan windows per CLI, and a detail drawer open on one row showing its full edit form",
    heading: "Every CLI, one table",
    bullets: [
      "Status lamp, login state, models by tier, and today's plan windows for every configured agent.",
      "A detail drawer per row holds the full edit form instead of a separate settings page.",
      "Ready means found, not signed in — the drawer is where you fix a logged-out CLI.",
    ],
  },
  {
    id: "review",
    label: "Review",
    screen: "review" as const,
    alt: "The Review screen listing frontier/* branches per repository with diffs, checks, and Merge/Delete actions behind a confirmation",
    heading: "Review before you merge",
    bullets: [
      "Every frontier/* branch a delegated, benched, or workspace run left behind, listed per repository.",
      "Each branch carries the verification report from the project's own checks — never a green tick it didn't earn.",
      "Merge and delete both sit behind an explicit confirmation dialog.",
    ],
  },
];

const features = [
  {
    title: "Routes to the right agent — and model",
    body: "Every task is classified — coding, debugging, review, planning, docs — then scored against provider affinity, your priorities, policy, current load, and what actually worked before. Pick Balanced, Quality first, or Token saver.",
    href: url("docs/routing"),
  },
  {
    title: "An optional second opinion on routing",
    body: "Jev, an auxiliary advisor, can score task type, complexity, and best-fit model — off by default, shadow to watch it without changing anything, or active to let it influence the route.",
    href: `${url("/")}#advisor`,
  },
  {
    title: "Fails over on quota, not on bugs",
    body: "Rate limits, overloads, and logged-out CLIs cool that provider down and move the work to the next eligible one. A genuine agent failure stops the task, because replaying half-finished edits is unsafe.",
    href: url("docs/routing"),
  },
  {
    title: "One MCP profile, every CLI",
    body: "Configure MCP servers, tool allow/deny lists, extra context dirs, and a shared system prompt once. Frontier translates them into each CLI's native flags at spawn time — no hand-edited agent configs.",
    href: url("docs/context-tools"),
  },
  {
    title: "Split work across agents",
    body: "Ask for a plan and Frontier delegates the subtasks in parallel, each in its own git worktree branch, then synthesizes a report. Your working tree is never a shared scratchpad.",
    href: url("docs/orchestration"),
  },
  {
    title: "Race agents head to head",
    body: "Send one identical prompt to several agents at once, each isolated on its own branch, and compare what they actually produced. No failover — a lane that fails is a result about that agent.",
    href: url("docs/orchestration"),
  },
  {
    title: "A room for your agents",
    body: "Workspaces give a repo one long-lived thread with named participants you address by @handle. Only who you mention replies, they answer in parallel, and every writing participant lands on its own review branch.",
    href: url("docs/collaboration"),
  },
  {
    title: "Review before you merge",
    body: "Delegated and benched runs leave frontier/* branches behind. The Review inbox lists them per repo with diffs and line counts, and merges or deletes them behind a confirmation.",
    href: url("docs/orchestration"),
  },
  {
    title: "Live work log, not a spinner",
    body: "Streamed output shows the model actually in use, each tool call and thinking step, and the files being written — plus a task-scoped context meter that reads real token usage.",
    href: url("docs/workspace"),
  },
  {
    title: "Conversations, not one-shots",
    body: "Every task is multi-turn. Claude Code resumes its real CLI session; other agents receive the attributed transcript. Switch the next provider mid-thread and the history follows.",
    href: url("docs/workspace"),
  },
  {
    title: "Usage you can actually see",
    body: "Per-provider plan windows, reset countdowns, tracked tokens, and cooldown state — read from what each CLI reports, never invented. Optional daily budgets give you a hard stop.",
    href: url("docs/workspace"),
  },
];

const steps = [
  { title: "Describe the task", body: "Prompt, working directory, routing mode. Attach images, reference files with @, or pin a specific agent and model." },
  { title: "Frontier picks an agent", body: "The task is classified and eligible providers are ranked. Anything rate-limited, busy, over budget, or cooling down is skipped." },
  { title: "The CLI runs locally", body: "The agent is spawned directly — no shell, prompt over stdin — reusing the login session already on your machine." },
  { title: "You watch and follow up", body: "Output streams live with tool calls and file changes. Reply in-thread, retry, cancel, or hand the conversation to another agent." },
];
---

<Base>
  <!-- ---------- Hero ---------- -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Local-first desktop orchestrator</p>
        <h1>Route coding tasks to the agents you already pay for.</h1>
        <p class="lede">
          Frontier Proxy is a desktop app that sends work to <strong>Codex CLI</strong>, <strong>Claude Code</strong>,
          <strong>GitHub Copilot CLI</strong>, <strong>OpenCode</strong>, and <strong>Ollama</strong> models already installed and signed in on
          your machine. It picks the right one, fails over when a plan runs out, and keeps every conversation in one place.
        </p>

        <div class="row" style="margin: 26px 0 22px">
          <a class="btn btn-primary" href="#download">Download v{version}</a>
          <a class="btn btn-secondary" href={url("docs")}>Read the docs</a>
        </div>

        <ul class="hero-trust">
          <li><span class="dot"></span> No API keys for coding agents</li>
          <li><span class="dot"></span> No telemetry</li>
          <li><span class="dot"></span> macOS · Windows · Linux</li>
          <li><span class="dot"></span> MIT licensed</li>
        </ul>
      </div>

      <!-- The real Tasks screen, framed as an app window: a bezel with corner
           ticks and a titlebar, not a hand-built HTML mock-up. -->
      <div class="app-frame panel">
        <div class="app-frame-titlebar">
          <span class="app-frame-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="app-frame-title readout">Frontier Proxy — Tasks</span>
        </div>
        <div class="app-frame-screen screen">
          <Screenshot
            name="tasks"
            alt="The Frontier Proxy desktop app's Tasks screen: a work queue on the left, a streaming conversation in the centre, and a route inspector open on the right showing the agent, model, and Jev's reasoning"
            eager
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- The pitch ---------- -->
  <section class="section" id="why">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why it exists</p>
        <h2>You are paying for several coding agents. Use all of them.</h2>
        <p>
          Each CLI is good at different work and each comes with its own plan limit. Frontier Proxy is the layer
          that decides which one takes a task, keeps working when one hits its ceiling, and gives you a single
          queue, history, and review surface across all of them.
        </p>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <div class="card-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M8 1.5 2 4.5v4c0 3.4 2.5 5.3 6 6.1 3.5-.8 6-2.7 6-6.1v-4L8 1.5Z" stroke-linejoin="round" />
            </svg>
          </div>
          <h3>Your subscriptions, not an API bill</h3>
          <p>
            Frontier never calls a model API on a coding agent's behalf and holds no execution keys of its own. It
            spawns the CLI you already logged into, and that CLI reuses its own session. The one narrow, opt-in
            exception is the <a href="#advisor">Jev routing advisor</a> — off by default, and it never runs an agent.
          </p>
        </div>
        <div class="card">
          <div class="card-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M2 8h3l2-4.5L9 12.5 11 8h3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3>Work keeps moving</h3>
          <p>
            Hit a five-hour limit mid-afternoon and the queue does not stop. Frontier detects the quota error,
            cools that agent down, and hands the task to the next eligible one.
          </p>
        </div>
        <div class="card">
          <div class="card-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M4.5 2v6.5M11.5 7.5V14M4.5 12.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM11.5 7.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke-linecap="round" />
            </svg>
          </div>
          <h3>Parallel, but isolated</h3>
          <p>
            Agents that run at the same time get their own git worktree branch. They cannot overwrite each
            other, and you review the diff before anything lands on your branch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- How it works ---------- -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Four steps, all on your machine.</h2>
      </div>
      <ol class="steps flow">
        {steps.map((step) => (
          <li>
            <h4>{step.title}</h4>
            <p class="muted" style="margin:4px 0 0;font-size:13.5px">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ---------- Inside the app ---------- -->
  <section class="section" id="tour">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Inside the app</p>
        <h2>An instrument panel, not a chat window.</h2>
        <p>Five screens, one console. See the <a href={url("docs/workspace")}>full walkthrough</a> in the docs.</p>
      </div>

      <div class="tour">
        <div class="segmented tour-tabs" id="tour-tabs" role="radiogroup" aria-label="App screen">
          {tour.map((t, i) => (
            <button
              type="button"
              role="radio"
              aria-checked={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-tour-tab={t.id}
              id={`tour-tab-${t.id}`}
              aria-controls={`tour-panel-${t.id}`}
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="tour-panels">
          {tour.map((t, i) => (
            <div
              class="tour-panel panel"
              id={`tour-panel-${t.id}`}
              data-tour-panel={t.id}
              role="region"
              aria-labelledby={`tour-tab-${t.id}`}
              hidden={i !== 0}
            >
              <div class="tour-shot screen">
                <Screenshot name={t.screen} alt={t.alt} />
              </div>
              <div class="tour-copy">
                <h3>{t.heading}</h3>
                <ul class="ticks">
                  {t.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    // Tab switching for the "Inside the app" tour — the same roving-tabindex
    // radiogroup pattern as the theme toggle (ThemeToggle.astro) and the
    // app's own ui/segmented.ts, reimplemented inline per-component since the
    // site shares no JS module between them.
    const group = document.getElementById("tour-tabs");
    const tabs = () => [...(group?.querySelectorAll<HTMLButtonElement>('[role="radio"]') ?? [])];
    const panels = () => [...document.querySelectorAll<HTMLElement>("[data-tour-panel]")];

    function select(tab: HTMLButtonElement): void {
      for (const el of tabs()) {
        const checked = el === tab;
        el.setAttribute("aria-checked", String(checked));
        el.tabIndex = checked ? 0 : -1;
      }
      const id = tab.dataset.tourTab;
      for (const panel of panels()) panel.hidden = panel.dataset.tourPanel !== id;
    }

    if (group) {
      for (const tab of tabs()) tab.addEventListener("click", () => select(tab));
      group.addEventListener("keydown", (event) => {
        const list = tabs();
        const current = list.indexOf(document.activeElement as HTMLButtonElement);
        if (current < 0) return;
        const move = (delta: number): void => {
          const next = list[(current + delta + list.length) % list.length];
          next.focus();
          select(next);
        };
        if (event.key === "ArrowRight" || event.key === "ArrowDown") { event.preventDefault(); move(1); }
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") { event.preventDefault(); move(-1); }
        else if (event.key === "Home") { event.preventDefault(); list[0].focus(); select(list[0]); }
        else if (event.key === "End") { event.preventDefault(); list[list.length - 1].focus(); select(list[list.length - 1]); }
      });
    }
  </script>

  <!-- ---------- Features ---------- -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>Everything the desktop app does.</h2>
        <p>Each card links to the documentation for that part of the app.</p>
      </div>
      <div class="grid grid-3">
        {features.map((feature) => (
          <a class="card" href={feature.href}>
            <h3>{feature.title}</h3>
            <p class="muted" style="font-size:13.5px">{feature.body}</p>
            <p class="card-more" style="margin:14px 0 0">Learn more →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ---------- Providers ---------- -->
  <section class="section" id="providers">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Supported agents</p>
        <h2>Bring the CLIs you already use.</h2>
        <p>
          Frontier detects each CLI, reports its version, and shows a green <strong>Ready</strong> badge when the
          binary is found. Authentication stays with the CLI's own login.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Agent</th><th>How Frontier runs it</th><th>Good for</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Codex CLI</strong></td>
              <td><code>codex exec --json --sandbox workspace-write</code></td>
              <td class="muted">Coding, debugging, long refactors</td>
            </tr>
            <tr>
              <td><strong>Claude Code</strong></td>
              <td><code>claude -p --output-format stream-json --permission-mode acceptEdits</code></td>
              <td class="muted">Coding, review, planning, resumable sessions</td>
            </tr>
            <tr>
              <td><strong>GitHub Copilot CLI</strong></td>
              <td><code>copilot -s --no-ask-user --allow-tool=…</code></td>
              <td class="muted">Coding, review, GitHub-aware work</td>
            </tr>
            <tr>
              <td><strong>OpenCode</strong></td>
              <td><code>opencode run --format json --dir &lt;cwd&gt;</code></td>
              <td class="muted">Coding, review, any model OpenCode is signed in to, resumable sessions</td>
            </tr>
            <tr>
              <td><strong>Codex + Ollama</strong></td>
              <td><code>codex exec --oss --local-provider ollama</code></td>
              <td class="muted">Coding with local inference</td>
            </tr>
            <tr>
              <td><strong>Ollama</strong></td>
              <td><code>ollama run &lt;model&gt;</code></td>
              <td class="muted">Planning, review, docs — no file tools</td>
            </tr>
            <tr>
              <td><strong>Any other CLI</strong></td>
              <td><code>your-agent {"{prompt}"} {"{cwd}"} {"{model}"}</code></td>
              <td class="muted">Custom local agents</td>
            </tr>
          </tbody>
        </table>
      </div>

      <Callout title="Ready means found, not signed in">
        <p>
          The Ready badge only runs <code>&lt;exe&gt; --version</code>. A CLI whose session has expired still shows
          Ready and will fail the task — the fix is to log in with that CLI, never to paste an API key.
          See <a href={url("docs/troubleshooting")}>troubleshooting</a>.
        </p>
      </Callout>
    </div>
  </section>

  <!-- ---------- Jev routing advisor ---------- -->
  <section class="section" id="advisor">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Optional · off by default</p>
        <h2>Jev, a second opinion on routing.</h2>
        <p>
          Jev (TypeSafe's System One model) is an auxiliary service, not a coding agent — it never generates text and
          never runs on your behalf. Turning it on is the one narrow, opt-in exception to "no API keys," and it stays
          off unless you enable it.
        </p>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <h3>Off</h3>
          <p class="muted" style="font-size:13.5px">The default. Routing scores exactly as it would with no advisor at all — nothing leaves this machine for routing purposes.</p>
        </div>
        <div class="card">
          <h3>Shadow</h3>
          <p class="muted" style="font-size:13.5px">Jev is asked and its pick is recorded next to the real route, visible in the calibration view — but it changes nothing about what runs.</p>
        </div>
        <div class="card">
          <h3>Active</h3>
          <p class="muted" style="font-size:13.5px">Its answers become bounded, labelled routing factors that can influence the pick — never overriding eligibility or an explicit choice.</p>
        </div>
      </div>

      <Callout tone="info" title="What leaves the machine when it's on">
        <p>
          The prompt text (trimmed to fit) and attachment <em>names</em> only — never attachment contents. When
          "share repo facts" is on (the default), also lightweight metadata: top languages, file count, manifest
          names, and top-level folder names. Frontier never reads a file to send it. A split &amp; delegate run also sends
          the planner's subtask prompts, which can quote code the planner read. The key itself
          is encrypted with your OS keychain and never reaches the renderer or the state file.
        </p>
      </Callout>

      <p class="muted" style="font-size:13px">
        A confidence threshold ignores low-confidence answers, and a hard 3-second deadline means a slow or failed
        request never blocks the queue — the task just falls back to Frontier's own heuristic classifier. Read the
        full mechanics, per-subtask advice, and the calibration view in
        {" "}<a href={url("docs/routing")}>routing &amp; the Jev advisor</a>, or TypeSafe's own
        {" "}<a href="https://docs.typesafe.ai" rel="noopener">documentation</a>.
      </p>
    </div>
  </section>

  <!-- ---------- Download ---------- -->
  <section class="section" id="download">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Download</p>
        <h2>Get Frontier Proxy v{version}</h2>
        <p>No build step required. Download, run, and point it at a folder.</p>
      </div>

      <DownloadTable />

      <div class="grid grid-2" style="margin-top:26px">
        <div class="card">
          <h4>Before the first run</h4>
          <p class="muted" style="font-size:13.5px;margin-bottom:10px">
            You need at least one supported CLI installed and signed in. Frontier does not install agents for you.
          </p>
          <a class="card-more" href={url("docs/providers")}>Provider setup →</a>
        </div>
        <div class="card">
          <h4>Unsigned builds</h4>
          <p class="muted" style="font-size:13.5px;margin-bottom:10px">
            Builds are x64 and unsigned. On macOS open it the first time with <strong>Control-click → Open</strong>;
            on Windows choose <strong>More info → Run anyway</strong>.
          </p>
          <a class="card-more" href={url("docs/install")}>Install guide →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Closing ---------- -->
  <section class="section closing">
    <div class="wrap center">
      <h2>Built to be inspected.</h2>
      <p class="lede" style="max-width:560px;margin:12px auto 26px">
        State lives in a single JSON file in your user data directory. Prompts go over stdin, never through a shell.
        The renderer has no Node access. Read every line of it.
      </p>
      <div class="row" style="justify-content:center">
        <a class="btn btn-primary" href="#download">Download</a>
        <a class="btn btn-secondary" href={REPO_URL} rel="noopener">View the source</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 64px 0 20px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: 54px; align-items: center; }
  .hero h1 { margin-bottom: 20px; }

  .hero-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 0; }
  .hero-trust li { display: flex; align-items: center; gap: 8px; color: var(--fg-muted); font-size: 12.5px; }

  /* ---- App frame: the real Tasks screenshot, framed as an app window ---- */
  .app-frame { overflow: hidden; box-shadow: var(--e-2-shadow); padding: 0; }
  /* Same corner-tick-vs-overflow-clip fix as DocsFigure.astro. */
  .app-frame::before { top: 0; left: 0; }
  .app-frame::after { top: 0; right: 0; }
  .app-frame-titlebar {
    display: flex; align-items: center; gap: 10px; padding: 9px 13px;
    background: var(--surface-2); border-bottom: 1px solid var(--bezel);
  }
  .app-frame-dots { display: flex; gap: 6px; }
  .app-frame-dots span { width: 8px; height: 8px; border-radius: 50%; background: var(--bezel-strong); }
  .app-frame-title { margin-left: 4px; font-size: 11px; }
  .app-frame-screen { border: 0; border-radius: 0; }
  .app-frame-screen :global(img) { display: block; width: 100%; height: auto; }

  /* ---- Step flow ---- */
  .steps.flow { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 26px; }
  .steps.flow > li { padding-left: 0; padding-top: 40px; }
  .steps.flow > li::before { top: 0; }

  .closing { border-top: 1px solid var(--bezel); }

  /* ---- Inside the app: segmented tour, real screenshots ---- */
  .tour { display: grid; gap: 22px; }
  .tour-tabs { align-self: start; }
  .tour-panel { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 0; overflow: hidden; }
  .tour-panel[hidden] { display: none; }
  .tour-panel::before { top: 0; left: 0; }
  .tour-panel::after { top: 0; right: 0; }
  .tour-shot { border: 0; border-radius: 0; border-right: 1px solid var(--bezel); }
  .tour-shot :global(img) { display: block; width: 100%; height: auto; }
  .tour-copy { padding: 24px 26px; align-self: center; }
  .tour-copy h3 { margin-bottom: 12px; }
  .tour-copy .ticks { margin-bottom: 0; }
  .tour-copy .ticks li { font-size: 13.5px; }

  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
